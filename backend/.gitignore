# .gitignore — FUTURiSE Monorepo
# Struktur: frontend/ (Next.js) + backend/ (Laravel)

# ============================================================
# SECRETS & ENV
# ============================================================
.env
.env.*
!.env.example
*.env

# ============================================================
# BACKEND — Laravel
# ============================================================
vendor/
node_modules/
storage/app/public/
storage/app/private/
storage/logs/
bootstrap/cache/
public/storage
public/hot
.phpunit.result.cache
coverage/
backend/vendor/
backend/node_modules/
backend/storage/app/public/
backend/storage/app/private/
backend/storage/logs/
backend/bootstrap/cache/
backend/public/storage
backend/public/hot
backend/.phpunit.result.cache
backend/coverage/

# ============================================================
# FRONTEND — Next.js
# ============================================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/.cache/

# ============================================================
# DOKUMENTASI INTERNAL (tidak perlu di repo)
# ============================================================
docs/
*.md
!README.md

# ============================================================
# FILE ROOT YANG TIDAK RELEVAN KE KODE
# ============================================================
backend.txt
rule github.txt
file tambahan/
*.txt
*.pdf
*.docx
*.xlsx
*.csv

# ============================================================
# AI TOOLS
# ============================================================
.gemini/
brain/
.agy/
*.ai_session

# ============================================================
# SYSTEM & IDE
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.suo
*.iml

# ============================================================
# LOGS
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# MISC
# ============================================================
*.zip
*.tar.gz
