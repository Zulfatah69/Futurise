# FUTURiSE Frontend (Next.js) Environment Configuration
# Salin file ini menjadi .env.local untuk development

# URL Backend REST API Laravel
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL Base Web Backend (Blade / Fortify Login & Register)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# URL Domain Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
