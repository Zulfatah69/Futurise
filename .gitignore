# .gitignore — FUTURiSE Monorepo Root

# ============================================================
# SECRETS & ENVIRONMENT
# ============================================================
.env
.env.*
!.env.example
*.env

# ============================================================
# DOKUMENTASI INTERNAL & FILE SPEK LOKAL (tidak untuk repo)
# ============================================================
/docs/
/*.md
!/README.md
/backend.txt
/rule github.txt
/spek web.txt
/file tambahan/
/*.txt
/*.pdf
/*.docx
/*.xlsx
/*.csv

# ============================================================
# TEST CACHE, COVERAGE & BUILD ARTIFACTS
# ============================================================
.phpunit.result.cache
coverage/
/backend/vendor/
/backend/node_modules/
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore
/backend/storage/app/private/*
!/backend/storage/app/private/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/public/storage
/backend/public/hot
/backend/.phpunit.result.cache
/backend/coverage/
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/dist/
/frontend/build/
/frontend/.cache/

# ============================================================
# AI TOOLS, OS & IDE
# ============================================================
.gemini/
.agy/
brain/
*.ai_session
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.suo
*.iml
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.zip
*.tar.gz
